local function applySpeed()
    local c=P.Character
    if c then
        local h=c:FindFirstChildOfClass("Humanoid")
        if h then h.WalkSpeed=curSpeed end
    end
end
local function updT() TKB.Text="Enable Speed: "..(kbToggle and ("["..kn(kbToggle).."]") or "[ ]") TKB.TextColor3=kbToggle and TX or TD end
local function updA() AKB.Text="Apply Keybind: "..(kbApply and ("["..kn(kbApply).."]") or "[ ]") AKB.TextColor3=kbApply and TX or TD end
local function updR() RKB.Text="Restore Keybind: "..(kbRestore and ("["..kn(kbRestore).."]") or "[ ]") RKB.TextColor3=kbRestore and TX or TD end
local function doRestore()
    curSpeed=origSpeed lastSpeed=origSpeed
    SL.Text="Current: "..math.floor(origSpeed)
    IB.Text=tostring(math.floor(origSpeed))
    if speedOn then applySpeed() end
end
local function toggleSpeed()
    speedOn=not speedOn
    TRK.BackgroundColor3=speedOn and AC or Color3.fromRGB(60,60,70)
    TS:Create(KN,TweenInfo.new(0.15),{Position=speedOn and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,2,0.5,-6)}):Play()
    if speedOn then
        curSpeed=lastSpeed
        SL.Text="Current: "..math.floor(curSpeed)
        applySpeed()
    else
        lastSpeed=curSpeed
        curSpeed=origSpeed
        SL.Text="Current: "..math.floor(origSpeed)
        applySpeed()
    end
end
TR.InputBegan:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then toggleSpeed() end
end)
AB.MouseButton1Click:Connect(function()
    local n=tonumber(IB.Text)
    if n then
        curSpeed=n lastSpeed=n
        SL.Text="Current: "..math.floor(curSpeed)
        if speedOn then applySpeed() end
