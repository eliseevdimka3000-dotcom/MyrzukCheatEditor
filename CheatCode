UIS.InputBegan:Connect(function(i,gpe)
    if gpe then return end
    if waitToggle then
        if i.UserInputType==Enum.UserInputType.Keyboard then
            local nk=i.KeyCode
            if kbApply==nk then kbApply=nil updA() end
            if kbRestore==nk then kbRestore=nil updR() end
            kbToggle=nk waitToggle=false updT() TKB.BackgroundColor3=IT
        end
        return
    end
    if waitApply then
        if i.UserInputType==Enum.UserInputType.Keyboard then
            local nk=i.KeyCode
            if kbToggle==nk then kbToggle=nil updT() end
            if kbRestore==nk then kbRestore=nil updR() end
            kbApply=nk waitApply=false updA() AKB.BackgroundColor3=IT
        end
        return
    end
    if waitRestore then
        if i.UserInputType==Enum.UserInputType.Keyboard then
            local nk=i.KeyCode
            if kbToggle==nk then kbToggle=nil updT() end
            if kbApply==nk then kbApply=nil updA() end
            kbRestore=nk waitRestore=false updR() RKB.BackgroundColor3=IT
        end
        return
    end
    if waitFly then
        if i.UserInputType==Enum.UserInputType.Keyboard then kbFly=i.KeyCode waitFly=false updFT() FTKB.BackgroundColor3=IT end
        return
    end
    if waitFlyApply then
        if i.UserInputType==Enum.UserInputType.Keyboard then kbFlyApply=i.KeyCode waitFlyApply=false updFA() FAKB.BackgroundColor3=IT end
        return
    end
    if waitNoclip then
        if i.UserInputType==Enum.UserInputType.Keyboard then noclipKb=i.KeyCode waitNoclip=false updNC() NCKB.BackgroundColor3=IT end
        return
    end
    if kbApply and i.KeyCode==kbApply then
        local n=tonumber(IB.Text)
        if n then
            curSpeed=n lastSpeed=n
            SL.Text="Current: "..math.floor(curSpeed)
            if speedOn then applySpeed() end
        end
    end
    if kbToggle and i.KeyCode==kbToggle then toggleSpeed() end
    if kbRestore and i.KeyCode==kbRestore then doRestore() end
    if kbFly and i.KeyCode==kbFly then toggleFly() end
    if noclipKb and i.KeyCode==noclipKb then toggleNoclip() end
    if kbFlyApply and i.KeyCode==kbFlyApply then
        local n=tonumber(FIB.Text)
        if n then flySpd=n FL.Text="Fly Speed: "..math.floor(flySpd) end
    end
end)

