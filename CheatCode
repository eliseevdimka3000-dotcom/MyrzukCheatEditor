RS.Heartbeat:Connect(function()
    local c=P.Character
    if not c then return end
    local h=c:FindFirstChildOfClass("Humanoid")
    if not h then return end
    if speedOn then
        if h.WalkSpeed~=curSpeed then h.WalkSpeed=curSpeed end
    else
        if h.WalkSpeed~=lastKnown then
            lastKnown=h.WalkSpeed origSpeed=h.WalkSpeed curSpeed=h.WalkSpeed
            SL.Text="Current Speed: "..math.floor(h.WalkSpeed)
            IB.Text=tostring(math.floor(h.WalkSpeed))
            RB.Text="Restore ("..math.floor(h.WalkSpeed)..")"
        end
    end
    if jumpOn then
        h.UseJumpPower=true
        if h.JumpPower~=curJumpPower then h.JumpPower=curJumpPower end
    end
end)

