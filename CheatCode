local function updNC() NCKB.Text="Noclip Keybind: "..(noclipKb and ("["..kn(noclipKb).."]") or "[ ]") NCKB.TextColor3=noclipKb and TX or TD end
local function toggleNoclip()
    noclipOn=not noclipOn
    NCTRK.BackgroundColor3=noclipOn and AC or Color3.fromRGB(60,60,70)
    TS:Create(NCKN,TweenInfo.new(0.15),{Position=noclipOn and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,2,0.5,-6)}):Play()
    if noclipOn then
        noclipConn=RS.Heartbeat:Connect(function()
            if not noclipOn then return end
            local c=P.Character
            if not c then return end
            for _,part in ipairs(c:GetDescendants()) do
                if part:IsA("BasePart") then
                    if not part.Name:lower():find("floor") and not part.Name:lower():find("ground") and not part.Name:lower():find("baseplate") then
                        part.CanCollide=false
                    end
                end
            end
        end)
    else
        if noclipConn then noclipConn:Disconnect() noclipConn=nil end
        local c=P.Character
        if c then
            for _,part in ipairs(c:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide=true end
            end
        end
    end
end
