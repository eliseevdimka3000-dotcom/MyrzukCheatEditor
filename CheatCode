local dragging=false
local dragStart
local startPos

T.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
        dragging=true
        dragStart=input.Position
        startPos=F.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
        local delta=input.Position-dragStart
        F.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
        dragging=false
    end
end)

local function makeTab(text, xPos, yPos, w)
    local btn=Instance.new("TextButton")
    btn.Size=UDim2.new(w or 0.22,0,0,24)
    btn.Position=UDim2.new(xPos,0,0,yPos)
    btn.BackgroundColor3=IT
    btn.Text=text
    btn.TextColor3=TD
    btn.Font=Enum.Font.GothamBold
    btn.TextSize=11
    btn.BorderSizePixel=0
    btn.ZIndex=2
    btn.Parent=F
    local c=Instance.new("UICorner") c.CornerRadius=UDim.new(0,5) c.Parent=btn
    return btn
end

