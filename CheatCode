local function stopFly()
    if flyConn then flyConn:Disconnect() flyConn=nil end
    workspace.Gravity=savedGravity
    local c=P.Character
    if c then
        local h=c:FindFirstChildOfClass("Humanoid")
        if h then
            h.PlatformStand=false
            pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
    end
end
local function startFly()
    stopFly()
    local c=P.Character
    if not c then return end
    local root=c:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local hum=c:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    hum.PlatformStand=true
    savedGravity=workspace.Gravity
    workspace.Gravity=0

    flyConn=RS.RenderStepped:Connect(function(dt)
        if not flyOn then return end
        local cc=P.Character
        if not cc then return end
        local rr=cc:FindFirstChild("HumanoidRootPart")
        if not rr then return end
        local cam=workspace.CurrentCamera

        local dir=Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir=dir+cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir=dir-cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir=dir-cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir=dir+cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir=dir+Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir=dir-Vector3.new(0,1,0) end

        local currentPos=rr.Position
        local newPos=currentPos
        if dir.Magnitude>0 then
            newPos=currentPos+dir.Unit*flySpd*dt
        end

        rr.CFrame=CFrame.new(newPos, newPos+cam.CFrame.LookVector)
        rr.AssemblyLinearVelocity=Vector3.zero
        rr.AssemblyAngularVelocity=Vector3.zero
    end)
end
local function updFT() FTKB.Text="Enable Fly: "..(kbFly and ("["..kn(kbFly).."]") or "[ ]") FTKB.TextColor3=kbFly and TX or TD end
local function updFA() FAKB.Text="Fly Apply Keybind: "..(kbFlyApply and ("["..kn(kbFlyApply).."]") or "[ ]") FAKB.TextColor3=kbFlyApply and TX or TD end
local function toggleFly()
    flyOn=not flyOn
    FTRK.BackgroundColor3=flyOn and AC or Color3.fromRGB(60,60,70)
    TS:Create(FKN,TweenInfo.new(0.15),{Position=flyOn and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,2,0.5,-6)}):Play()
    if flyOn then startFly() else stopFly() end
end
